<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mộc — Windows Toolkit" Width="1220" Height="920" MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#1D2021" Foreground="#D4BE98" FontFamily="Segoe UI" FontSize="14">
 <!-- [VI] Style dùng chung: màu Gruvbox, nút, ô nhập, tab. -->
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#323633"/><Setter Property="Foreground" Value="#D4BE98"/><Setter Property="BorderBrush" Value="#484B42"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#A9B665"/><Setter TargetName="Bd" Property="Background" Value="#42483B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#D8A657"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#A9B665"/><Setter Property="Foreground" Value="#1D2021"/><Setter Property="BorderBrush" Value="#A9B665"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#242827"/><Setter Property="Foreground" Value="#D4BE98"/><Setter Property="CaretBrush" Value="#A9B665"/><Setter Property="BorderBrush" Value="#484B42"/><Setter Property="Padding" Value="12,9"/><Setter Property="SelectionBrush" Value="#56603E"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D4BE98"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B3AC99"/><Setter Property="Padding" Value="17,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="#242827" BorderBrush="#484B42" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#A9B665"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#A9B665"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <!-- [VI] Bố cục 5 hàng: tiêu đề, giới thiệu, các tab, nhật ký, footer. -->
 <Grid Margin="26,18,26,16">
  <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="125"/><RowDefinition Height="*"/><RowDefinition Height="140"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Grid Grid.Row="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="mộc" FontFamily="Consolas" FontSize="32" FontWeight="Bold" Foreground="#A9B665"/><TextBlock Text=" / WINDOWS TOOLKIT" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="20,4,0,0" Foreground="#928F80"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="WingetBadge" Text="●  winget · kiểm tra khi sử dụng" Foreground="#D8A657" VerticalAlignment="Center" Margin="0,0,18,0" FontSize="12"/><Button x:Name="ThemeButton" Content="◐  Đổi màu" FontSize="12" Padding="12,6" Margin="0"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Máy của bạn. Theo cách của bạn." FontSize="29" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock Text="Cài ứng dụng. Chỉnh không gian làm việc. Giữ quyền kiểm soát." Foreground="#A6A28F"/><TextBlock Text="LOCAL FIRST   /   REVIEW BEFORE RUN   /   MADE FOR WINDOWS" FontFamily="Consolas" FontSize="11" Foreground="#7DAEA3" Margin="0,15,0,0"/></StackPanel><Border Grid.Column="1" Background="#272C26" BorderBrush="#414A35" BorderThickness="1" CornerRadius="6" Padding="17,12"><StackPanel><TextBlock Text="[  CHỦ ĐỘNG &amp; AN TOÀN  ]" Foreground="#A9B665" FontFamily="Consolas" FontSize="12"/><TextBlock Text="Chỉ chạy sau khi bạn xem và xác nhận.&#x0a;Tinh chỉnh có bản sao để hoàn tác." FontSize="12" Foreground="#B5B09E" Margin="0,9,0,0" LineHeight="20"/></StackPanel></Border></Grid>
  <TabControl x:Name="Tabs" Grid.Row="2" Background="#1D2021" BorderThickness="0" Padding="0,14,0,0">
   <!-- [VI] Tab 1: tìm kiếm, nhóm, thẻ ứng dụng (UI.ps1 dựng), nút cài/cập nhật/gỡ. -->
   <TabItem Header="01  Ứng dụng"><Grid><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" ToolTip="Tìm tên, mã winget hoặc nhóm (Ctrl+F)" VerticalContentAlignment="Center"/><TextBlock x:Name="SearchHint" Text="Tìm ứng dụng hoặc mã winget…  Ctrl+F" IsHitTestVisible="False" Foreground="#858779" Margin="13,0,0,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="DevPreset" Content="Bộ lập trình"/><Button x:Name="BasicPreset" Content="Bộ cơ bản"/><Button x:Name="ClearSelection" Content="Bỏ chọn" Margin="0"/></StackPanel></Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Categories" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer>
    <ScrollViewer x:Name="AppsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="AppCards" Margin="0,6,0,4"/></ScrollViewer>
    <Grid Grid.Row="3" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SelectionLabel" Text="0 ứng dụng đã chọn" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="12"/><Button x:Name="InstallButton" Content="Cài đặt đã chọn →" Style="{StaticResource Primary}"/><Button x:Name="UpgradeButton" Content="Cập nhật"/><Button x:Name="UninstallButton" Content="Gỡ cài đặt"/></StackPanel><Button x:Name="InventoryButton" Content="Xem máy đã cài gì" HorizontalAlignment="Right" Margin="0"/></Grid>
   </Grid></TabItem>
   <!-- [VI] Tab 2-4: tinh chỉnh, công cụ Windows, hướng dẫn. Thẻ được dựng trong UI.ps1. -->
   <TabItem Header="02  Tinh chỉnh"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Thay đổi nhỏ. Có đường quay lại." FontSize="22" Margin="0,5,0,8"/><TextBlock Text="Chỉ thay đổi tài khoản hiện tại. Lưu giá trị gốc trước khi ghi và kiểm tra lại sau khi ghi." Foreground="#A6A28F" Margin="0,0,0,18"/><StackPanel x:Name="TweakCards"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="03  Công cụ Windows"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Đúng công cụ, đúng lúc." FontSize="22" Margin="0,5,0,8"/><TextBlock Text="Dùng công cụ có sẵn của Windows. UAC chỉ xuất hiện khi thao tác thực sự cần quyền quản trị." Foreground="#A6A28F" Margin="0,0,0,18"/><WrapPanel x:Name="ToolCards"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="04  Hướng dẫn"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6"><TextBlock Text="Một toolkit dễ hiểu, dễ tiếp tục phát triển." FontSize="23" Margin="0,6,0,18"/><TextBlock TextWrapping="Wrap" Foreground="#B5B09E" LineHeight="26" Text="1. Chọn ứng dụng hoặc một bộ gợi ý. Bạn có thể xem thông tin gói trước khi cài.&#x0a;2. Xem kế hoạch: lệnh cụ thể, nguồn winget và tác động. Chỉ xác nhận khi đã đọc.&#x0a;3. Theo dõi nhật ký. Dừng hàng đợi sẽ bỏ các mục chưa chạy, không ngắt installer đang chạy.&#x0a;4. Tinh chỉnh luôn lưu bản sao gốc. Dùng Hoàn tác để trả lại giá trị trước đó.&#x0a;5. SFC / DISM mở riêng với UAC; không đóng cửa sổ khi công cụ còn hoạt động.&#x0a;&#x0a;Mộc không gửi telemetry. Winget và ứng dụng được cài có kết nối mạng riêng.&#x0a;Không có phần mềm nào bảo đảm an toàn tuyệt đối; hãy sao lưu dữ liệu quan trọng.&#x0a;Không tự nhận diện bản cài từ vị trí tùy chỉnh. Nút Mở chỉ hỗ trợ một số ứng dụng có chữ ký hợp lệ."/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="DocsButton" Content="Mở tài liệu dự án"/><Button x:Name="LogsButton" Content="Mở nhật ký &amp; bản sao"/></StackPanel><TextBlock Text="MỘC 0.1.0  /  POWERSHELL + WPF  /  KHÔNG LIÊN KẾT VỚI CTT HAY OMARCHY" FontFamily="Consolas" FontSize="11" Foreground="#7DAEA3" Margin="0,24,0,0"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <!-- [VI] Khung trạng thái + nhật ký thao tác; nút Dừng hàng đợi chỉ bỏ các mục chưa chạy. -->
  <Border Grid.Row="3" BorderBrush="#41443C" BorderThickness="1" Background="#181B1B" CornerRadius="5" Margin="0,15,0,0" Padding="13,10"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="StatusText" Text="●  SẴN SÀNG  /  Chưa có thay đổi nào được thực hiện" Foreground="#A9B665" FontFamily="Consolas" FontSize="12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CopyLogButton" Content="Sao chép" FontSize="11" Padding="8,3"/><Button x:Name="StopButton" Content="Dừng hàng đợi" IsEnabled="False" FontSize="11" Padding="8,3" Margin="0"/></StackPanel><TextBox x:Name="LogBox" Grid.Row="1" Text="[mộc] Chào bạn. Chọn việc cần làm; xem kế hoạch trước khi chạy." IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#A6A28F" FontFamily="Consolas" FontSize="12" Padding="0,5,0,0"/></Grid></Border>
  <TextBlock Grid.Row="4" Text="Ít xáo trộn hơn. Nhiều chủ động hơn." FontSize="11" Foreground="#888B7D" VerticalAlignment="Bottom"/><TextBlock Grid.Row="4" x:Name="Footer" Text="v0.1.0   /   LOCAL SESSION" FontFamily="Consolas" FontSize="11" Foreground="#888B7D" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
 </Grid>
</Window>
